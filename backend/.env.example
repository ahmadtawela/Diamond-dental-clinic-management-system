APP_NAME=Diamond
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=diamond_dental
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

# Comma-separated list of frontend origins allowed to call the API with cookies
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# SMS / WhatsApp reminder provider (fill in when wiring the 24h reminder job)
REMINDER_PROVIDER=
REMINDER_API_KEY=
